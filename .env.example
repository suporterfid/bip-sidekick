# Bip Sidekick - configuration
# Copy to .env and fill in. NEVER commit .env; it is gitignored.

# Hermes provider auth
# API keys are the recommended path for scheduled/headless runs.
ANTHROPIC_API_KEY=

# Telegram command inbox + approval surface
# Create a bot via @BotFather. Get your numeric chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # compatibility input; entrypoint maps this to TELEGRAM_ALLOWED_USERS
TELEGRAM_ALLOWED_USERS=      # optional; defaults to TELEGRAM_CHAT_ID when empty

# Google Calendar + Gmail, READ-ONLY
# OAuth2 "installed app" credentials from Google Cloud Console.
# Generate a refresh token once, offline, with read-only scopes only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Obsidian vault sync
# A PRIVATE git repo the vault syncs to, so your devices stay current.
VAULT_GIT_REMOTE=
VAULT_GIT_BRANCH=main
GIT_SYNC_INTERVAL=300        # seconds

# OpenWA WhatsApp read-only triage; only needed for the openwa profile.
OPENWA_API_KEY=              # a strong random string

# Behavior
BRIEF_CRON=0 6 * * *         # daily brief time, in TZ below
TZ=America/Sao_Paulo
GATE_MODE=strict             # policy flag; Hermes approvals enforce dangerous shell gates
