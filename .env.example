# ─────────────────────────────────────────────────────────────────────────────
# Solo Agent Stack — configuration
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Agent auth (pick ONE) ─────────────────────────────────────────────────────
# API key bills per token — predictable for scheduled/headless runs.
ANTHROPIC_API_KEY=
# OR a Claude Code OAuth token from a subscription. Note: subscriptions are meant
# for interactive use; confirm current terms before relying on it for cron jobs.
CLAUDE_CODE_OAUTH_TOKEN=

# ── Telegram (command inbox + approval gate) ──────────────────────────────────
# Create a bot via @BotFather. Get your numeric chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # allowlist — only messages from this chat are honored

# ── Google (Calendar + Gmail, READ-ONLY) ──────────────────────────────────────
# OAuth2 "installed app" credentials from Google Cloud Console.
# Generate a refresh token once, offline, with read-only scopes only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Obsidian vault sync ────────────────────────────────────────────────────────
# A PRIVATE git repo the vault syncs to (so your laptop/phone Obsidian stays current).
VAULT_GIT_REMOTE=
VAULT_GIT_BRANCH=main
GIT_SYNC_INTERVAL=300       # seconds

# ── OpenWA (WhatsApp read-only triage) — only needed for the openwa profile ────
OPENWA_API_KEY=             # a strong random string

# ── Behavior ──────────────────────────────────────────────────────────────────
BRIEF_CRON=0 6 * * *        # daily brief time (cron), in TZ below
TZ=America/Sao_Paulo
GATE_MODE=strict            # strict = every send/deploy/spend requires a tap
